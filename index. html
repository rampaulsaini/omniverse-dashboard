    <style>
        :root {
            --primary-gold: #d4af37;
            --secondary-gold: #f3e5ab;
            --bg-dark: #0f1016;
            --card-bg: rgba(255, 255, 255, 0.05);
            --text-light: #f8f9fa;
            --text-dim: #b3b3b3;
            --accent-blue: #00d2ff;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-light);
            line-height: 1.6;
            overflow-x: hidden;
        }

        /* Background Glow Effect */
        .glow-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: radial-gradient(circle at 50% 20%, rgba(212, 175, 55, 0.15), transparent 70%);
            z-index: -1;
            pointer-events: none;
        }

        /* Header / Banner */
        header {
            text-align: center;
            padding: 60px 20px 40px;
            background: rgba(0, 0, 0, 0.4);
            border-bottom: 1px solid rgba(212, 175, 55, 0.2);
            backdrop-filter: blur(10px);
        }

        header img.profile-img {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            border: 3px solid var(--primary-gold);
            object-fit: cover;
            box-shadow: 0 0 25px rgba(212, 175, 55, 0.4);
            margin-bottom: 15px;
        }

        header h1 {
            font-family: 'Rozha One', serif;
            font-size: 2.8rem;
            color: var(--primary-gold);
            letter-spacing: 1px;
            margin-bottom: 10px;
        }

        header p {
            font-size: 1.1rem;
            color: var(--text-dim);
            max-width: 600px;
            margin: 0 auto;
        }

        /* Container & Navigation Tabs */
        .container {
            max-width: 1200px;
            margin: 30px auto;
            padding: 0 20px;
        }

        .category-title {
            font-size: 1.8rem;
            color: var(--primary-gold);
            margin: 40px 0 20px;
            border-left: 4px solid var(--primary-gold);
            padding-left: 15px;
            font-family: 'Rozha One', serif;
        }

        /* Grid System */
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 20px;
        }

        /* Cards */
        .card {
            background: var(--card-bg);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 20px;
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            backdrop-filter: blur(5px);
        }

        .card:hover {
            transform: translateY(-5px);
            border-color: var(--primary-gold);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.5), 0 0 15px rgba(212, 175, 55, 0.2);
            background: rgba(255, 255, 255, 0.08);
        }

        .card-icon {
            font-size: 2rem;
            color: var(--primary-gold);
            margin-bottom: 15px;
        }

        .card h3 {
            font-size: 1.2rem;
            margin-bottom: 10px;
            color: var(--text-light);
        }

        .card p.badge {
            font-size: 0.85rem;
            color: var(--accent-blue);
            font-weight: 600;
            margin-bottom: 15px;
        }

        .card a.btn {
            display: inline-block;
            text-align: center;
            background: transparent;
            color: var(--primary-gold);
            border: 1px solid var(--primary-gold);
            padding: 8px 15px;
            border-radius: 6px;
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .card a.btn:hover {
            background: var(--primary-gold);
            color: #000;
        }

        /* Footer */
        footer {
            text-align: center;
            padding: 40px 20px;
            margin-top: 60px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            color: var(--text-dim);
            font-size: 0.9rem;
        }

        footer a {
            color: var(--primary-gold);
            text-decoration: none;
        }

        /* Responsive */
        @media (max-width: 768px) {
            header h1 { font-size: 2rem; }
            .grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
